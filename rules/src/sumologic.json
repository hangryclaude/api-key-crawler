  "source": "cmd/generate/config/rules/sumologic.go",
  "rules": [
    {
      "id": "sumologic-access-id",
      "description": "Discovered a SumoLogic Access ID, potentially compromising log management services and data analytics integrity.",
      "confidence": "medium",
      "regex": "(?i)(?:(?-i:[Ss]umo|SUMO))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}((?-i:su)[a-zA-Z0-9]{12})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "sumo"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    },
    {
      "id": "sumologic-access-token",
      "description": "Uncovered a SumoLogic Access Token, which could lead to unauthorized access to log data and analytics insights.",
      "confidence": "medium",
      "regex": "(?i)(?:(?-i:[Ss]umo|SUMO))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9]{64})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "sumo"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
