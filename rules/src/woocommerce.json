{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/woocommerce.go",
  "rules": [
    {
      "id": "woocommerce-consumer-secret.1",
      "description": "WooCommerce REST API consumer secret, which may allow read or write access to a store with the associated consumer key.",
      "confidence": "high",
      "regex": "(?i)(?:woo)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(cs_[a-f0-9]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "wooc",
        "woo-",
        "woo_",
        "cs_"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      }
    }
  ]
}
