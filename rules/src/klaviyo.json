{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/klaviyo.go",
  "rules": [
    {
      "id": "klaviyo-api-key",
      "description": "Detected a Klaviyo API key, which may expose Klaviyo account and marketing data.",
      "confidence": "high",
      "regex": "(?i)(?:klaviyo)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(pk_[a-z0-9]{34})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "klaviyo"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
