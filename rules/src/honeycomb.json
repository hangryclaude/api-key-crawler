{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/honeycomb.go",
  "rules": [
    {
      "id": "honeycomb-api-key",
      "description": "Detected a Honeycomb API key, which may expose Honeycomb telemetry and environment data.",
      "confidence": "medium",
      "regex": "(?i)(?:honeycomb)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}((?:[a-f0-9]{32}|[a-z0-9]{22}))(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "honeycomb"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      },
      "validates": true
    }
  ]
}
