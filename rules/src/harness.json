{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/harness.go",
  "rules": [
    {
      "id": "harness-api-key",
      "description": "Identified a Harness Access Token (PAT or SAT), risking unauthorized access to a Harness account.",
      "confidence": "high",
      "regex": "(?:pat|sat)\\.[a-zA-Z0-9_-]{22}\\.[0-9a-f]{24}\\.[a-zA-Z0-9]{20}",
      "keywords": [
        "pat.",
        "sat."
      ],
      "filter": {
        "entropy": {
          "min": 3.4,
          "strict": true
        }
      },
      "validates": true
    }
  ]
}
