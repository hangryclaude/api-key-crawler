    {
      "id": "gcp-application-default-credentials",
      "description": "Google (GCP) Application Default Credentials",
      "confidence": "high",
      "regex": "\\{[^{]+(?:(?:\"client_secret\"\\s*:\\s*\"[^\"]+\"[^}]+\"refresh_token\"\\s*:\\s*\"[^\"]+\")|(?:\"refresh_token\"\\s*:\\s*\"[^\"]+\"[^}]+\"client_secret\"\\s*:\\s*\"[^\"]+\"))[^}]+\\}",
      "keywords": [
        ".apps.googleusercontent.com"
      ],
      "validates": true
    },
    {
      "id": "gcp-gemini-api",
      "description": "Detected a Google Gemini API key, which may expose Gemini model access and usage to unauthorized parties.",
      "confidence": "high",
      "regex": "\\b(AQ\\.Ab8RN6[A-Za-z0-9_-]{44})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "aq.ab8rn6"
      ],
      "filter": {
        "entropy": {
          "min": 4,
          "strict": true
        }
      },
      "validates": true
    },
    {
      "id": "gcp-service-account",
      "description": "Google (GCP) Service-account",
      "confidence": "high",
      "regex": "\\{[^{]+(?:(?:\"private_key\"\\s*:\\s*\"-----BEGIN (?:RSA )?PRIVATE KEY-----[^}]+auth_provid(?:)er_x509_cert(?:)_url)|(?:auth_provide(?:)r_x509_cert_(?:)url[^}]+\"private_key\"\\s*:\\s*\"-----BEGIN (?:RSA )?PRIVATE KEY-----))[^}]+\\}",
      "keywords": [
        "provider_x509"
      ],
      "filter": {
        "dropWords": [
          "image-pulling@authenticated-image-pulling.iam.gserviceaccount.com"
        ]
      },
      "validates": true
    }
  ]
