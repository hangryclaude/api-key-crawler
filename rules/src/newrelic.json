      "id": "new-relic-browser-api-token",
      "description": "Identified a New Relic ingest browser API token, risking unauthorized access to application performance data and analytics.",
      "confidence": "high",
      "regex": "(?i)(?:new-relic|newrelic|new_relic)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(NRJS-[a-f0-9]{19})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "nrjs-"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    },
    {
