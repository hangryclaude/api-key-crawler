{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/kraken.go",
  "rules": [
    {
      "id": "kraken-access-token",
      "description": "Identified a Kraken Access Token, potentially compromising cryptocurrency trading accounts and financial security.",
      "confidence": "medium",
      "regex": "(?i)(?:kraken)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9\\/=_\\+\\-]{80,90})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "kraken"
      ],
      "filter": {
        "entropy": {
          "min": 4,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
