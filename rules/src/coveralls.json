{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/coveralls.go",
  "rules": [
    {
      "id": "coveralls-personal-api-token",
      "description": "Detected a Coveralls personal API token, which may expose repository coverage data.",
      "confidence": "medium",
      "regex": "(?i)(?:coveralls)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9-]{37})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "coveralls"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
