  "source": "cmd/generate/config/rules/cursor.go",
  "rules": [
    {
      "id": "cursor-api-key",
      "description": "Detected a Cursor Integrations API Key, which may expose AI-assisted development services to unauthorized access.",
      "confidence": "medium",
      "regex": "(?i)(?:cursor)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(key_[0-9a-f]{64})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "cursor"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": true
        }
      },
      "validates": true
    }
  ]
}
