  "source": "cmd/generate/config/rules/resend.go",
  "rules": [
    {
      "id": "resend-api-key.1",
      "description": "Resend API key, which may allow sending email or managing account resources.",
      "confidence": "high",
      "regex": "\\b(re_[1-9A-HJ-NP-Za-km-z]{8}_[1-9A-HJ-NP-Za-km-z]{24})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "resend"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
