{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/okta.go",
  "rules": [
    {
      "id": "okta-access-token",
      "description": "Identified an Okta Access Token, which may compromise identity management services and user authentication data.",
      "confidence": "high",
      "regex": "(?i:(?:(?-i:[Oo]kta|OKTA))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(00[\\w=\\-]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "okta"
      ],
      "filter": {
        "entropy": {
          "min": 4,
          "strict": true
        }
      }
    }
  ]
}
