{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/zai.go",
  "rules": [
    {
      "id": "zai-api-key",
      "description": "Detected a Z.ai API key, which may expose GLM model access and usage to unauthorized parties.",
      "confidence": "medium",
      "regex": "(?i)(?:zai|z_ai|z\\.ai|glm|zlm)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-f0-9]{32}\\.[a-z0-9]{16})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "zai",
        "z_ai",
        "z.ai",
        "glm",
        "zlm"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": true
        }
      },
      "validates": true
    }
  ]
}
