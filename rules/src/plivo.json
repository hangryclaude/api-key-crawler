{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/plivo.go",
  "rules": [
    {
      "id": "plivo-auth-id",
      "description": "Plivo Auth ID, used as a component of the Plivo Auth Token composite rule.",
      "confidence": "high",
      "regex": "(?i)(?:plivo(?:[_. -]*(?:auth|account))?[_. -]*(?:id|sid))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(MA[A-Z0-9]{18})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "plivo"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 2.8,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    },
    {
      "id": "plivo-auth-token",
      "description": "Plivo Auth Token.",
      "confidence": "high",
      "regex": "(?i:(?:plivo(?:[_. -]*(?:auth))?[_. -]*(?:secret|token|key))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9_-]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "plivo"
      ],
      "components": [
        {
          "id": "plivo-auth-id"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      },
      "validates": true
    }
  ]
}
