{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/clerk.go",
  "rules": [
    {
      "id": "clerk-secret-key",
      "description": "Detected a Clerk secret key, which may allow unauthorized access to Clerk backend APIs.",
      "confidence": "medium",
      "regex": "(?i)(?:clerk)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(sk_(?:test|live)_[A-Za-z0-9]{32})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "clerk"
      ],
      "filter": {
        "entropy": {
          "min": 3.3,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
