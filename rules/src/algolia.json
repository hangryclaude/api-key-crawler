{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/algolia.go",
  "rules": [
    {
      "id": "algolia-api-key",
      "description": "Identified an Algolia API Key, which could result in unauthorized search operations and data exposure on Algolia-managed platforms.",
      "confidence": "high",
      "regex": "(?i)(?:algolia)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9]{32})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "algolia"
      ],
      "components": [
        {
          "id": "algolia-application-id"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      },
      "validates": true
    },
    {
      "id": "algolia-application-id",
      "description": "Detected an Algolia application ID, used as a component of the algolia-api-key composite rule.",
      "confidence": "high",
      "regex": "(?i)(?:algolia)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9]{10})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "algolia"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 2.75,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
