  "rules": [
    {
      "id": "freemius-secret-key",
      "description": "Detected a Freemius secret key, potentially exposing sensitive information.",
      "confidence": "medium",
      "regex": "(?i)[\"']secret_key[\"']\\s*=>\\s*[\"'](sk_[\\S]{29})[\"']",
      "path": "(?i)\\.php$",
      "keywords": [
        "secret_key"
      ]
    }
  ]
}
