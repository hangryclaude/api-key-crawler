{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/atlassian.go",
  "rules": [
    {
      "id": "atlassian-api-token",
      "description": "Detected an Atlassian Cloud API token, posing a threat to project management and collaboration tool security and data confidentiality.",
      "confidence": "high",
      "regex": "\\b(ATAT[A-Za-z0-9_\\-=]{100,})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "atat"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
