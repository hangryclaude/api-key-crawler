{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/figma.go",
  "rules": [
    {
      "id": "figma-personal-access-header-token",
      "description": "Uncovered a Figma Personal Access Token in a header, which may compromise design assets and team collaboration.",
      "confidence": "high",
      "regex": "(?i)(?:x-figma-token|xfigmatoken|x_figma_token)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([0-9A-F]{4}-[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "x-figma-token",
        "xfigmatoken",
        "x_figma_token"
      ],
      "validates": true
    },
    {
      "id": "figma-personal-access-token",
      "description": "Uncovered a Figma Personal Access Token, which may compromise design assets and team collaboration.",
      "confidence": "high",
      "regex": "(?i)\\b(figd_[A-Z0-9_-]{38,42})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "figd_"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": true
        }
      },
      "validates": true
    }
  ]
}
