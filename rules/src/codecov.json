{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/codecov.go",
  "rules": [
    {
      "id": "codecov-access-token",
      "description": "Found a pattern resembling a Codecov Access Token, posing a risk of unauthorized access to code coverage reports and sensitive data.",
      "confidence": "high",
      "regex": "(?i)(?:codecov)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Z0-9-]{36})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "codecov"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      },
      "validates": true
    }
  ]
}
