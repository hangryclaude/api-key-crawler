  "source": "cmd/generate/config/rules/postmark.go",
  "rules": [
    {
      "id": "postmark-api-token.1",
      "description": "Postmark server or account API token, which may allow access to email delivery and account configuration.",
      "confidence": "high",
      "regex": "(?i)(?:postmark)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "postmark"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
