{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/lob.go",
  "rules": [
    {
      "id": "lob-api-key",
      "description": "Uncovered a Lob API Key, which could lead to unauthorized access to mailing and address verification services.",
      "confidence": "medium",
      "regex": "(?i)(?:lob)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}((live|test)_[a-f0-9]{35})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "test_",
        "live_"
      ]
    },
    {
      "id": "lob-pub-api-key",
      "description": "Detected a Lob Publishable API Key, posing a risk of exposing mail and print service integrations.",
      "confidence": "medium",
      "regex": "(?i)(?:lob)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}((test|live)_pub_[a-f0-9]{31})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "test_pub_",
        "live_pub_"
      ]
    }
  ]
}
