{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/datadog.go",
  "rules": [
    {
      "id": "datadog-api-key",
      "description": "Detected a Datadog API key, potentially risking monitoring and analytics data exposure and manipulation.",
      "confidence": "high",
      "regex": "(?i)(?:datadog)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9]{32})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "datadog"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    },
    {
      "id": "datadog-application-key",
      "description": "Detected a Datadog application key, which may expose Datadog account and monitoring data when paired with an API key.",
      "confidence": "high",
      "regex": "(?i)(?:datadog)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9-]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "datadog"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      }
    }
  ]
}
