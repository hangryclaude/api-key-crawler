  "source": "cmd/generate/config/rules/rootly.go",
  "rules": [
    {
      "id": "rootly-api-key.1",
      "description": "Rootly API key.",
      "confidence": "high",
      "regex": "\\b(rootly_[a-f0-9]{64})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
