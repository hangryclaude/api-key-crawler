{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/aws.go",
  "rules": [
    {
      "id": "aws-access-token",
      "description": "Identified an AWS access key ID paired with a secret access key, which together can provide full access to AWS services.",
      "confidence": "high",
      "regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b",
      "keywords": [
        "a3t",
        "akia",
        "asia",
        "abia",
        "acca"
      ],
      "components": [
        {
          "id": "aws-secret-access-key",
          "within": "5L"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": true
        },
        "dropRegex": [
          ".+EXAMPLE$"
        ]
      },
      "validates": true
    },
    {
      "id": "aws-amazon-bedrock-api-key-long-lived",
      "description": "Identified a pattern that may indicate long-lived Amazon Bedrock API keys, risking unauthorized Amazon Bedrock usage",
      "confidence": "high",
      "regex": "\\b(ABSK[A-Za-z0-9+/]{109,269}={0,2})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "absk"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": true
        }
      }
    },
    {
      "id": "aws-amazon-bedrock-api-key-short-lived",
      "description": "Identified a pattern that may indicate short-lived Amazon Bedrock API keys, risking unauthorized Amazon Bedrock usage",
      "confidence": "high",
      "regex": "bedrock-api-(?:)key-YmVkcm9j(?:)ay5hbWF6b25h(?:)d3MuY29t",
      "keywords": [
        "bedrock-api-key-"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": true
        }
      }
    },
    {
      "id": "aws-secret-access-key",
      "description": "Identified an AWS secret access key, used as a component of the aws-access-token composite rule.",
      "confidence": "medium",
      "regex": "(?i:(?:secret|access|key|token)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9/+=]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "secret",
        "access",
        "key",
        "token"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 4,
          "strict": true
        }
      }
    }
  ]
}
