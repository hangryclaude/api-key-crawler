{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/tableau.go",
  "rules": [
    {
      "id": "tableau-personal-access-token-name.1",
      "description": "Tableau personal access-token name, used as a component of the token rule.",
      "confidence": "high",
      "regex": "(?i:(?:tableau(?:[_. -]*(?:personal[_. -]*access|pat))?[_. -]*(?:token[_. -]*)?name)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z][A-Za-z0-9_-]{2,50})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "tableau"
      ],
      "skipReport": true
    },
    {
      "id": "tableau-personal-access-token.1",
      "description": "Tableau personal access token.",
      "confidence": "high",
      "regex": "\\b([A-Za-z0-9+/]{22}==:[A-Za-z0-9]{32})\\b",
      "keywords": [
        "tableau"
      ],
      "components": [
        {
          "id": "tableau-personal-access-token-name.1",
          "within": "20L"
        },
        {
          "id": "tableau-server-host.1",
          "within": "20L"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    },
    {
      "id": "tableau-server-host.1",
      "description": "Tableau Online server host, used as a component of the personal access-token rule.",
      "confidence": "high",
      "regex": "(?i)\\b([a-z0-9-]+\\.online\\.tableau\\.com)\\b",
      "keywords": [
        "online.tableau.com"
      ],
      "skipReport": true
    }
  ]
}
