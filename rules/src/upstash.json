{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/upstash.go",
  "rules": [
    {
      "id": "upstash-redis-rest-token.1",
      "description": "Upstash Redis REST token, which may grant read-only or full access to an Upstash database.",
      "confidence": "high",
      "regex": "(?i:(?:upstash)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}((?:[A-Za-z0-9]{32,48}|AYNgAS[A-Za-z0-9+/_-]{26,90}={0,2}))(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "upstash"
      ],
      "components": [
        {
          "id": "upstash-redis-rest-url.1",
          "within": "5L"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    },
    {
      "id": "upstash-redis-rest-url.1",
      "description": "Upstash Redis REST URL, used as a component of the Upstash REST-token composite rule.",
      "confidence": "high",
      "regex": "(?i)\\b(https://[a-z0-9][a-z0-9-]{2,63}\\.upstash\\.io)(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "upstash.io"
      ],
      "skipReport": true
    }
  ]
}
