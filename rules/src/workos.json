  "source": "cmd/generate/config/rules/workos.go",
  "rules": [
    {
      "id": "workos-production-api-key.1",
      "description": "WorkOS production API key.",
      "confidence": "high",
      "regex": "(?i:(?:workos(?:[_. -]*(?:api))?[_. -]*(?:secret|key|token))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(sk_live_a2V5Xz[A-Za-z0-9+/]{69}={0,2})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "workos"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "dropRegex": [
          "(?i)example"
        ]
      },
      "validates": true
    }
  ]
}
