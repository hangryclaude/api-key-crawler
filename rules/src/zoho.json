      "confidence": "medium",
      "regex": "(?i)(?:zoho)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(1000\\.[a-z0-9]{30})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "zoho"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      }
    },
    {
