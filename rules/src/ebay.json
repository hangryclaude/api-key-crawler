{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/ebay.go",
  "rules": [
    {
      "id": "ebay-client-id",
      "description": "eBay client ID, used as a component of the eBay client-secret composite rule.",
      "confidence": "high",
      "regex": "\\b([a-zA-Z0-9_-]+-[a-zA-Z0-9_-]+-PRD-[a-f0-9]{8,12}-[a-f0-9]{8,12})",
      "keywords": [
        "-prd-"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      }
    },
    {
      "id": "ebay-client-secret",
      "description": "eBay client secret.",
      "confidence": "high",
      "regex": "(?i:(?:ebay(?:[_. -]*(?:client|api))?[_. -]*(?:secret|key))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(PRD-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4,12})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "ebay"
      ],
      "components": [
        {
          "id": "ebay-client-id"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
