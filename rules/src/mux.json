{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/mux.go",
  "rules": [
    {
      "id": "mux-access-token-id.1",
      "description": "Mux access-token ID, used as a component of the Mux access-token-secret composite rule.",
      "confidence": "medium",
      "regex": "(?i)(?:mux[_.-]?(?:access[_.-]?)?token[_.-]?(?:id|identifier))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "mux"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      }
    },
    {
      "id": "mux-access-token-secret.1",
      "description": "Mux access-token secret, which may grant access to video, data, or system APIs when paired with its token ID.",
      "confidence": "high",
      "regex": "(?i:(?:mux[_.-]?(?:access[_.-]?)?token[_.-]?(?:secret|private|key))(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9+/]{75})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "mux"
      ],
      "components": [
        {
          "id": "mux-access-token-id.1",
          "within": "5L"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
