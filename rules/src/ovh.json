{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/ovh.go",
  "rules": [
    {
      "id": "ovh-application-key",
      "description": "OVHcloud Application Key - component of authenticated OVH API requests.",
      "confidence": "medium",
      "regex": "(?i)(?:app(?:lication)?[_.-]{0,1}key)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9-]{16})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "ovh"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 2,
          "strict": true
        }
      }
    },
    {
      "id": "ovh-application-secret",
      "description": "OVHcloud Application Secret - component of authenticated OVH API requests, which could allow unauthorized access to OVHcloud infrastructure when combined with Application and Consumer keys.",
      "confidence": "high",
      "regex": "(?i)(?:app(?:lication)?[_.-]{0,1}secret)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9-]{32})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "ovh"
      ],
      "components": [
        {
          "id": "ovh-application-key",
          "within": "20L"
        },
        {
          "id": "ovh-consumer-key",
          "within": "20L"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": true
        }
      },
      "validates": true
    },
    {
      "id": "ovh-consumer-key",
      "description": "OVHcloud Consumer Key - component of authenticated OVH API requests.",
      "confidence": "medium",
      "regex": "(?i)(?:consumer[_.-]{0,1}key)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([A-Za-z0-9-]{32})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "ovh"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 2,
          "strict": true
        }
      }
    }
  ]
}
