{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/devin.go",
  "rules": [
    {
      "id": "devin-personal-api-key",
      "description": "Detected a Cognition Devin personal API key, which may expose Devin sessions and user data.",
      "confidence": "high",
      "regex": "\\b(apk_user_[A-Za-z0-9+/]{120,180}={0,2})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "apk_user_"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    },
    {
      "id": "devin-service-api-key",
      "description": "Detected a Cognition Devin service API key, which may expose Devin sessions and organization access.",
      "confidence": "high",
      "regex": "\\b(apk_[A-Za-z0-9+/]{80,100}={0,2})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "apk_"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    },
    {
      "id": "devin-service-user-token",
      "description": "Detected a Cognition Devin service user token, which may expose Devin service user access.",
      "confidence": "high",
      "regex": "\\b(cog_[a-z2-7]{52})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "cog_"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
