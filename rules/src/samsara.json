  "source": "cmd/generate/config/rules/samsara.go",
  "rules": [
    {
      "id": "samsara-api-token.1",
      "description": "Samsara API token.",
      "confidence": "high",
      "regex": "\\b(samsara_api_[A-Za-z0-9]{26,32})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "samsara_api_"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
