  "source": "cmd/generate/config/rules/finnhub.go",
  "rules": [
    {
      "id": "finnhub-access-token",
      "description": "Found a Finnhub Access Token, risking unauthorized access to financial market data and analytics.",
      "confidence": "high",
      "regex": "(?i)(?:finnhub)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9]{20})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "finnhub"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
