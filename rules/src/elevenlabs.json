  "rules": [
    {
      "id": "elevenlabs-api-key",
      "description": "Detected an ElevenLabs API Key, which may expose AI voice synthesis services to unauthorized access.",
      "confidence": "high",
      "regex": "(?i)(?:elevenlabs)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(sk_[0-9a-f]{48})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "elevenlabs"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": true
        }
      }
    }
  ]
}
