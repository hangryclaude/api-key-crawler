        "dvc_mobile_"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      },
      "validates": true
    },
    {
      "id": "devcycle-server-sdk-key",
      "description": "DevCycle server SDK key.",
      "confidence": "high",
      "regex": "\\b(dvc_server_[A-Za-z0-9]{8,32})",
      "keywords": [
        "dvc_server_"
