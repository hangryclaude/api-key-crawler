  "source": "cmd/generate/config/rules/virustotal.go",
  "rules": [
    {
      "id": "virustotal-api-key.1",
      "description": "VirusTotal API key, which may expose private submissions, intelligence, or account API access.",
      "confidence": "high",
      "regex": "(?i)(?:virustotal)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-f0-9]{64})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "virustotal"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
