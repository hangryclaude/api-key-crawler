  "source": "cmd/generate/config/rules/looker.go",
  "rules": [
    {
      "id": "looker-client-id",
      "description": "Found a Looker Client ID, risking unauthorized access to a Looker account and exposing sensitive data.",
      "confidence": "medium",
      "regex": "(?i)(?:looker)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9]{20})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "looker"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    },
    {
      "id": "looker-client-secret",
      "description": "Found a Looker Client Secret, risking unauthorized access to a Looker account and exposing sensitive data.",
      "confidence": "medium",
      "regex": "(?i)(?:looker)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9]{24})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "looker"
      ],
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
