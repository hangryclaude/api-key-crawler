{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/cohere.go",
  "rules": [
    {
      "id": "cohere-api-token",
      "description": "Identified a Cohere Token, posing a risk of unauthorized access to AI services and data manipulation.",
      "confidence": "medium",
      "regex": "(?i:(?:cohere|CO_API_KEY)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3})(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-zA-Z0-9]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "cohere",
        "co_api_key"
      ],
      "filter": {
        "entropy": {
          "min": 4,
          "strict": false
        },
        "tokenRatio": 2.5
      },
      "validates": true
    }
  ]
}
