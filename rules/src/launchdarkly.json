  "source": "cmd/generate/config/rules/launchdarkly.go",
  "rules": [
    {
      "id": "launchdarkly-access-token",
      "description": "Uncovered a Launchdarkly Access Token, potentially compromising feature flag management and application functionality.",
      "confidence": "high",
      "regex": "(?i)(?:launchdarkly)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-z0-9=_\\-]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "launchdarkly"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "tokenRatio": 2.5
      }
    }
  ]
}
