{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/ramp.go",
  "rules": [
    {
      "id": "ramp-client-id",
      "description": "Ramp client ID, used as a component of the Ramp client-secret composite rule.",
      "confidence": "high",
      "regex": "\\b(ramp_id_[A-Za-z0-9]{40})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "ramp_id_"
      ],
      "skipReport": true,
      "filter": {
        "entropy": {
          "min": 3,
          "strict": false
        }
      }
    },
    {
      "id": "ramp-client-secret",
      "description": "Ramp OAuth client secret.",
      "confidence": "high",
      "regex": "\\b(ramp_sec_[A-Za-z0-9]{48})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "ramp_sec_"
      ],
      "components": [
        {
          "id": "ramp-client-id"
        }
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
