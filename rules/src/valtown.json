{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/valtown.go",
  "rules": [
    {
      "id": "val-town-api-token.1",
      "description": "Val Town API token.",
      "confidence": "high",
      "regex": "\\b(vtwn_[A-Za-z0-9_-]{20,80})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "vtwn_"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        },
        "require": [
          [
            "^(?:[^0-9]*[0-9]){2}"
          ]
        ]
      },
      "validates": true
    }
  ]
}
