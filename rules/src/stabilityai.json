  "source": "cmd/generate/config/rules/stabilityai.go",
  "rules": [
    {
      "id": "stability-ai-api-key",
      "description": "Detected a Stability AI API Key, which may expose AI image generation services to unauthorized access.",
      "confidence": "medium",
      "regex": "(?i)(?:stability)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(sk-[A-Za-z0-9]{48})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "stability"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": true
        }
      }
    }
  ]
}
