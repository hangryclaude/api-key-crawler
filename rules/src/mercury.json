  "source": "cmd/generate/config/rules/mercury.go",
  "rules": [
    {
      "id": "mercury-production-api-token",
      "description": "Mercury production API token.",
      "confidence": "high",
      "regex": "\\b(mercury_production_[a-z]{3,6}_[A-Za-z0-9]{40,50}_yrucrem)(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "mercury_production_"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": false
        }
      },
      "validates": true
    }
  ]
}
