{
  "lineage": "betterleaks",
  "licence": "MIT",
  "source": "cmd/generate/config/rules/ollama.go",
  "rules": [
    {
      "id": "ollama-api-key",
      "description": "Detected an Ollama API Key, which may expose local and hosted AI model serving to unauthorized access.",
      "confidence": "high",
      "regex": "(?i)(?:ollama)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}([a-f0-9]{32}\\.[a-zA-Z0-9_-]{24})(?:\\\\?['\"\\x60]|[\\s;]|\\\\[nr]|$)",
      "keywords": [
        "ollama"
      ],
      "filter": {
        "entropy": {
          "min": 3.5,
          "strict": true
        }
      }
    }
  ]
}
